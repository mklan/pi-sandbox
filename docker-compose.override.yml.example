# Personal settings for one machine. Copy to docker-compose.override.yml
# (git-ignored) and adjust — docker compose merges it into
# docker-compose.yml automatically, so `pi-run` and `docker compose ...`
# see the merged result without extra flags.

services:
  pi:
    environment:
      # Session timezone.
      TZ: UTC
      # Default model for every session (leave empty or remove to let each
      # session's caller decide).
      PI_DEFAULT_PROVIDER: anthropic
      PI_DEFAULT_MODEL: claude-sonnet-4-5
      PI_DEFAULT_THINKING: high
    volumes:
      # The folders the agent may work in — one line per folder. Anything
      # under /workspace/<name> in the container maps to the host folder
      # on the left. Add as many as you like:
      - /home/you/code:/workspace/code
      - /home/you/notes:/workspace/notes
      # Alias mounts (needed for docker): the host daemon resolves bind
      # mounts on the HOST, where /workspace/... does not exist. Mounting
      # each folder a second time at its REAL host path lets agents run
      # docker compose / -v mounts from a host-valid cwd — translate with
      # `pi-hostpath <sandbox-path>` inside the sandbox, never guess.
      # Same sources, so no new exposure, just a second view:
      # - /home/you/code:/home/you/code
      # - /home/you/notes:/home/you/notes
      # Do NOT invent aliases from /proc/self/mountinfo's root field:
      # it is filesystem-relative, not a host path (e.g. when the source
      # disk is mounted at /home on the host, the root shows a prefix
      # that does not exist on the host and the daemon cannot see —
      # aliasing it only teaches pi-hostpath daemon-invalid paths).
      # `pi-hostpath` already resolves the daemon-valid form; just keep
      # its output cd-able by aliasing each real host path (the left side
      # above) as itself.
      # git-over-ssh (read-only; ssh warns that it cannot update
      # known_hosts — that is intentional):
      # - /home/you/.ssh:/home/pi/.ssh:ro
      # Docker daemon socket (opt-in, host-root-equivalent — see README):
      # lets agents run docker / docker compose for e2e tests. After
      # uncommenting, the next `pi-run` rebuilds automatically with the
      # host's docker GID (manual fallback: DOCKER_GID=$(getent group
      # docker | cut -d: -f3) docker compose build).
      # - /var/run/docker.sock:/var/run/docker.sock
    # Resource limits — adjust to your machine.
    deploy:
      resources:
        limits:
          memory: 8G
          cpus: "4.0"
