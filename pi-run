#!/usr/bin/env bash
# pi sandbox launcher — one herdr inside the container, one shortcut on
# the host.
#
#   pi-run [-s|--sandbox <name>] [-b] [--tab] [path] [pi-args...]
#                                       open herdr on the folder's workspace
#                                       (pi-args always start a FRESH pi
#                                       session in a new pane (or, with --tab,
#                                       in a new tab); no args
#                                       reattaches to the running one)
#   pi-run sandboxes [path]         list the image variants (default,
#                                       android), which one is selected,
#                                       and the workspace default (if any)
#   pi-run sandboxes --set <name> [path]
#                                       set the workspace default sandbox
#                                       (writes <path>/.pi-sandbox)
#   pi-run sandboxes --unset [path]   remove the workspace default
#   pi-run ls [-w]                    list workspaces and agents (-w: live)
#   pi-run log <path|name>            show a workspace's current screen
#   pi-run shell [path|name] [cmd...] bash in the sandbox at the folder
#   pi-run kill <path|name|--all>     close one or all workspaces
#   pi-run down                       stop the sandbox (everything stops)
#   pi-run upgrade [version]          pin pi in the Dockerfile and rebuild
#   pi-run upgrade-herdr [version]    pin herdr in the Dockerfile and rebuild
#   pi-run upgrade-node [version]     pin Node.js in the Dockerfile and rebuild
#   pi-run upgrade-docker [version]   pin the Docker CLI in the Dockerfile and rebuild
#   pi-run upgrade-compose [version]  pin the compose plugin in the Dockerfile and rebuild
#   pi-run upgrade-kotlin [version]   pin the Kotlin compiler in the Dockerfile and rebuild
#   pi-run upgrade-gradle [version]   pin Gradle in the Dockerfile and rebuild
#   pi-run help                       this text
#
# Sandboxes: the image is multi-stage (see container/Dockerfile) — `default`
# (base Ubuntu + Node.js + Docker CLI) for everyday work, `android` (default
# + JDK + Android SDK + Gradle + Kotlin) for Kotlin/Android builds. Pick one
# per invocation (`pi-run -s android ~/code/app`, also `open`/`shell`), or
# export PI_SANDBOX=android for the whole shell, or set a per-workspace
# default with a `.pi-sandbox` file in the project folder (see
# `pi-run sandboxes --set android ~/code/app`). Precedence: -s/--sandbox
# flag, then PI_SANDBOX env, then the workspace `.pi-sandbox` file, then
# `default`. Switching variants recreates the container (workspaces and pi
# sessions are restored from the volume).
#
# The sandbox container runs herdr (herdr.dev) as its main process. herdr
# is a terminal workspace manager for coding agents: one workspace per
# folder, every pane/agent/command kept alive by the herdr server inside
# the container — independent of your SSH connection, this script, or any
# TUI client. No tmux involved anywhere.
#
# This script is only a convenience layer: it makes sure the container and
# its herdr server are up, opens (or creates) the workspace for a folder,
# focuses it, and drops you into the herdr TUI. First open of a folder
# starts pi in its workspace (with the PI_DEFAULT_* model defaults, like
# before); everything that runs there keeps running until you close it.
# With no extra args an existing workspace is just focused. With extra
# args (a prompt and/or pi flags) a fresh pi session is always started in
# a new pane of that workspace, leaving the old session running. When the
# folder is inside a git repo, that fresh session is isolated in its own
# worktree on its own branch (agent/<slug>) — see maybe_isolate_worktree —
# so parallel agents never share one checkout and fork history.
#
# Inside the TUI: detach with ctrl+b q — panes and agents keep working.
# Re-attach by running this script again (any folder, or none for the
# current one). Press ctrl+b then ? in the TUI for all keys, or use the
# mouse: herdr is mouse-first.
#
# Paths may be host paths or container paths (/workspace/...) and must lie
# inside one of the folders mounted under /workspace. Which folders those
# are is configured in docker-compose.yml / docker-compose.override.yml
# and discovered here from the merged compose config — add a mount and it
# becomes a valid workspace folder. A bare folder name works too when it is
# unambiguous (any folder under one of the mounts is found by name), and so
# does a workspace name (its label) or id (w1, w2, ...). With no path at
# all, pi-run opens the current folder; from outside the mounts it just
# attaches wherever you left off.
set -euo pipefail

SERVICE_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

err() { printf 'pi-run: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }

usage() {
  awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"
}

# workspace names must be safe in labels and CLI args
slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9_-]/-/g; s/--*/-/g; s/^-//; s/-$//'
}

hash4() { printf '%s' "$1" | cksum | awk '{ printf "%04x", $1 % 65536 }'; }

# --- sandbox (image variant) selection -----------------------------------
# The image is multi-stage (see container/Dockerfile): `default` for
# everyday work, `android` for Kotlin/Android builds. Select per invocation
# (`pi-run -s android ...`, also after `open`/`shell`), via PI_SANDBOX, or
# via a per-workspace `.pi-sandbox` file in the project folder (see below).
# Precedence: -s/--sandbox flag, then PI_SANDBOX env, then the workspace
# file, then `default`. This maps to the compose build target + image
# suffix (see docker-compose.yml) and to the image name ensure_image
# checks/builds.
SANDBOX="${PI_SANDBOX:-default}"
SANDBOX_FROM_CLI=0
PI_SANDBOX_TARGET="default"
PI_SANDBOX_SUFFIX=""
IMAGE="pi-sandbox"
# Per-workspace default: a `.pi-sandbox` file in the project folder, e.g.
# `sandbox=android`. Searched upward from the workspace folder to the
# mount root, so opening a subdir still picks up the project default.
WORKSPACE_CONFIG_NAME=".pi-sandbox"

select_sandbox() {
  case "$SANDBOX" in
    default) PI_SANDBOX_TARGET="default"; PI_SANDBOX_SUFFIX=""; IMAGE="pi-sandbox" ;;
    android) PI_SANDBOX_TARGET="android"; PI_SANDBOX_SUFFIX="-android"; IMAGE="pi-sandbox-android" ;;
    *) die "unknown sandbox: $SANDBOX (want default|android)" ;;
  esac
  export PI_SANDBOX_TARGET PI_SANDBOX_SUFFIX
}

# print the `.pi-sandbox` file for a host dir (searching upward to the
# mount root), or nothing when there is none
workspace_config_file() {
  local dir="$1" cur cfg
  cur="$(realpath -m "$dir")"
  while :; do
    cfg="$cur/$WORKSPACE_CONFIG_NAME"
    if [[ -f "$cfg" ]]; then printf '%s' "$cfg"; return 0; fi
    # stop above the mounted folders (host_path fails outside them)
    local parent m
    parent="$(dirname "$cur")"
    [[ "$parent" == "$cur" ]] && return 0
    m="$(mount_for_host "$parent" 2>/dev/null || true)"
    [[ -n "$m" ]] || return 0
    cur="$parent"
  done
}

# print the sandbox named in a workspace dir's config file (empty = none).
# Accepted lines (last match wins; `#` comments and blanks ignored):
#   sandbox=android | PI_SANDBOX=android | sandbox: android | android
read_workspace_sandbox() {
  local dir="$1" cfg line val="" low
  cfg="$(workspace_config_file "$dir")"
  [[ -n "$cfg" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [[ -z "$line" || "$line" == \#* ]] && continue
    line="$(printf '%s' "$line" | sed 's/[[:space:]]*#.*$//; s/[[:space:]]*$//')"
    [[ -z "$line" ]] && continue
    low="$(printf '%s' "$line" | tr '[:upper:]' '[:lower:]')"
    if [[ "$low" =~ ^pi_sandbox[[:space:]]*[:=][[:space:]]*(.+)$ ]]; then
      val="${BASH_REMATCH[1]}"
    elif [[ "$low" =~ ^sandbox[[:space:]]*[:=][[:space:]]*(.+)$ ]]; then
      val="${BASH_REMATCH[1]}"
    elif [[ "$low" =~ ^(default|android)$ ]]; then
      val="$low"
    else
      continue
    fi
  done < "$cfg"
  val="$(printf '%s' "$val" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/^"//; s/"$//')"
  # strip matching single quotes (kept out of the sed above for quoting)
  val="${val%\'}"
  val="${val#\'}"
  [[ -z "$val" ]] && return 0
  case "$val" in
    default|android) printf '%s' "$val" ;;
    *) err "ignoring unknown sandbox '$val' in $cfg (want default|android)" ;;
  esac
  return 0
}

# apply the workspace file default for a host dir unless the user already
# picked a sandbox explicitly (flag or env). Prints the source on change.
maybe_apply_workspace_sandbox() {
  local dir="$1" from_cfg cfg
  [[ $SANDBOX_FROM_CLI -eq 0 ]] || return 1
  [[ -z "${PI_SANDBOX:-}" ]] || return 1
  from_cfg="$(read_workspace_sandbox "$dir")" || true
  [[ -n "$from_cfg" ]] || return 1
  if [[ "$from_cfg" != "$SANDBOX" ]]; then
    SANDBOX="$from_cfg"
    select_sandbox
    cfg="$(workspace_config_file "$dir")"
    echo "using $SANDBOX sandbox (from $cfg)"
  fi
  return 0
}

# explicit sandbox choice: -s/--sandbox flag or PI_SANDBOX env. A workspace
# `.pi-sandbox` file or the built-in default is implicit: opening such a
# workspace must never downgrade a running android container (android is
# a superset of default, so default workspaces run fine there), otherwise
# a bare `pi-run` from a default project would kill android workspaces.
# Downgrades happen only on explicit request (`pi-run -s default ...`).
sandbox_is_explicit() {
  [[ $SANDBOX_FROM_CLI -eq 1 ]] || [[ -n "${PI_SANDBOX:-}" ]]
}

# --- workspace mounts ----------------------------------------------------
# The folders the agent may work in are exactly the bind mounts under
# /workspace in the effective compose config (docker-compose.yml merged
# with docker-compose.override.yml). Discovering them there keeps the
# compose files the single source of truth.
M_HOST=()
M_CTR=()
mounts_loaded=0

load_mounts() {
  [[ $mounts_loaded -eq 1 ]] && return
  mounts_loaded=1
  local cfg pairs host ctr
  cfg="$(cd "$SERVICE_DIR" && docker compose config)" \
    || die "cannot read the docker compose config in $SERVICE_DIR"
  # pull "host<tab>container" pairs for bind mounts with a /workspace target
  # out of the normalized config (service volumes section, long syntax)
  pairs="$(printf '%s\n' "$cfg" | awk '
    /^    volumes:$/       { vol = 1; next }
    vol && /^    [a-z_]/   { vol = 0 }
    !vol                   { next }
    /- type: / {
      if (type == "bind" && src ~ "^/" && tgt ~ "^/workspace") print src "\t" tgt
      type = $3; src = ""; tgt = ""; next
    }
    /^ +source: /          { src = $2 }
    /^ +target: /          { tgt = $2 }
    END {
      if (type == "bind" && src ~ "^/" && tgt ~ "^/workspace") print src "\t" tgt
    }')"
  while IFS=$'\t' read -r host ctr; do
    [[ -n "$host" && -n "$ctr" ]] || continue
    M_HOST+=("$host")
    M_CTR+=("$ctr")
  done <<< "$pairs"
  [[ ${#M_HOST[@]} -gt 0 ]] \
    || die "no folders mounted under /workspace — add some in docker-compose.yml or docker-compose.override.yml"
}

joined_hosts() { load_mounts; local IFS=', '; printf '%s' "${M_HOST[*]}"; }
joined_ctrs()  { load_mounts; local IFS=', '; printf '%s' "${M_CTR[*]}"; }

# find the mount a path belongs to (longest match wins); prints
# "host<tab>container".
mount_for_host() {
  local p="$1" i best=-1
  load_mounts
  for i in "${!M_HOST[@]}"; do
    case "$p" in
      "${M_HOST[$i]}"|"${M_HOST[$i]}"/*)
        if [[ $best -lt 0 || ${#M_HOST[$i]} -gt ${#M_HOST[$best]} ]]; then best=$i; fi ;;
    esac
  done
  if [[ $best -ge 0 ]]; then
    printf '%s\t%s\n' "${M_HOST[$best]}" "${M_CTR[$best]}"
  fi
  return 0
}

mount_for_ctr() {
  local p="$1" i best=-1
  load_mounts
  for i in "${!M_CTR[@]}"; do
    case "$p" in
      "${M_CTR[$i]}"|"${M_CTR[$i]}"/*)
        if [[ $best -lt 0 || ${#M_CTR[$i]} -gt ${#M_CTR[$best]} ]]; then best=$i; fi ;;
    esac
  done
  if [[ $best -ge 0 ]]; then
    printf '%s\t%s\n' "${M_HOST[$best]}" "${M_CTR[$best]}"
  fi
  return 0
}

# canonical host path from user input (host path, container path, or .)
host_path() {
  load_mounts
  local p="${1:-.}" abs m mh mc cand i
  local matches=()
  case "$p" in
    /workspace|/workspace/*)
      m="$(mount_for_ctr "$p")"
      [[ -n "$m" ]] || { err "$p is not a mounted folder (mounted: $(joined_ctrs))"; return 1; }
      IFS=$'\t' read -r mh mc <<<"$m"
      p="$mh${p#"$mc"}"
      ;;
  esac
  abs="$(realpath -m "$p")"
  if [[ ! -d "$abs" && "$p" != */* && "$p" != /* ]]; then
    # bare folder name: look for it under one of the mounts — first as a
    # direct child of a mount root, then anywhere below (bounded depth,
    # skipping hidden folders and node_modules)
    for i in "${!M_HOST[@]}"; do
      cand="${M_HOST[$i]}/$p"
      [[ -d "$cand" ]] && matches+=("$(realpath -m "$cand")")
    done
    if [[ ${#matches[@]} -eq 0 ]]; then
      for i in "${!M_HOST[@]}"; do
        while IFS= read -r cand; do
          matches+=("$(realpath -m "$cand")")
        done < <(find "${M_HOST[$i]}" -maxdepth 4 \
          \( -name '.*' -o -name node_modules \) -prune \
          -o -type d -name "$p" -print 2>/dev/null)
      done
    fi
    if [[ ${#matches[@]} -gt 1 ]]; then
      mapfile -t matches < <(printf '%s\n' "${matches[@]}" | sort -u)
    fi
    if [[ ${#matches[@]} -eq 1 ]]; then
      abs="${matches[0]}"
    elif [[ ${#matches[@]} -gt 1 ]]; then
      err "ambiguous folder name '$p': ${matches[*]}"; return 1
    else
      err "unknown workspace or folder: $p"; return 1
    fi
  fi
  [[ -d "$abs" ]] || { err "not a directory: $p"; return 1; }
  m="$(mount_for_host "$abs")"
  [[ -n "$m" ]] || { err "outside the mounted folders ($(joined_hosts)): $abs"; return 1; }
  printf '%s' "$abs"
}

container_path() {
  local m mh mc
  m="$(mount_for_host "$1")"
  [[ -n "$m" ]] || return 0
  IFS=$'\t' read -r mh mc <<<"$m"
  printf '%s%s' "$mc" "${1#"$mh"}"
}

# host path for a container path (inverse of container_path)
host_path_from_ctr() {
  local m mh mc
  m="$(mount_for_ctr "$1")"
  [[ -n "$m" ]] || return 0
  IFS=$'\t' read -r mh mc <<<"$m"
  printf '%s%s' "$mh" "${1#"$mc"}"
}

# display form: the container path minus the /workspace prefix, e.g.
# "stack/services/pi-sandbox"
short_path() {
  local m mh mc
  m="$(mount_for_host "$1")"
  if [[ -z "$m" ]]; then printf '%s' "$1"; return 0; fi
  IFS=$'\t' read -r mh mc <<<"$m"
  printf '%s%s' "${mc#/workspace/}" "${1#"$mh"}"
}

# --- container & herdr plumbing -----------------------------------------
# The container is a long-running compose service; herdr's server inside it
# owns every terminal. All herdr CLI calls go through `docker exec` (the
# CLI is inside the container; JSON is parsed there too, so the host needs
# nothing but docker).

compose() { (cd "$SERVICE_DIR" && docker compose "$@"); }

CTR=""

# the running sandbox container id (empty when the service is down)
# NOTE: the compose service name is auto-detected (first service in the
# compose config), so renaming the service key (pi <-> pi-sandbox) does
# not break this script.
find_ctr() {
  [[ -n "$CTR" ]] && return 0
  local svc
  svc="$(compose config --services 2>/dev/null | head -1)"
  [[ -n "$svc" ]] || svc="pi"
  CTR="$(compose ps -q "$svc" 2>/dev/null | head -1)"
  # fall back to any running container of this project (covers a rename
  # where an old-named container is still up)
  [[ -n "$CTR" ]] || CTR="$(compose ps -q 2>/dev/null | head -1)"
  [[ -n "$CTR" ]]
}

require_stack() {
  find_ctr || die "the sandbox is not running — run pi-run to start it"
  docker exec "$CTR" herdr status server >/dev/null 2>&1 \
    || die "the herdr server is not answering in the container — see: docker compose logs"
}

# start (or resume) the container and wait until herdr accepts commands
ensure_stack() {
  ensure_image
  local need_up=0 reason="" switching=0
  if ! find_ctr || ! docker exec "$CTR" herdr status server >/dev/null 2>&1; then
    need_up=1
    reason="starting the sandbox container (herdr keeps everything running)..."
  else
    # one container serves one variant. Workspaces and pi sessions
    # restore from the volume on recreate.
    local cur_img cur_base
    cur_img="$(docker inspect "$CTR" --format '{{.Config.Image}}' 2>/dev/null || true)"
    cur_base="${cur_img%%:*}" # strip any :tag compose may report
    if [[ -n "$cur_base" && "$cur_base" != "$IMAGE" ]]; then
      if [[ "$IMAGE" == *-android ]]; then
        # android required (workspace file / flag / env): upgrade even
        # when the request was implicit — default cannot run android work.
        need_up=1
        switching=1
        reason="switching sandbox to $SANDBOX (was $cur_img) -- recreating the container (workspaces restore from the volume)..."
      elif sandbox_is_explicit; then
        # explicit downgrade (`-s default` / PI_SANDBOX=default): honor it.
        need_up=1
        switching=1
        reason="switching sandbox to $SANDBOX (was $cur_img) -- recreating the container (workspaces restore from the volume)..."
      else
        # implicit default (bare `pi-run`, no workspace file): keep the
        # running android container — default workspaces run fine there
        # and a downgrade would disrupt android workspaces.
        SANDBOX="android"
        select_sandbox
        echo "keeping android sandbox (running) for a default workspace — android runs everything default can (use -s default to force a downgrade)" >&2
      fi
    fi
  fi
  if [[ $need_up -eq 1 ]]; then
    echo "$reason"
    local old_ctr="${CTR:-}"
    compose up -d >/dev/null || die "cannot start the sandbox container"
    CTR=""
    local i
    # wait up to ~60s: entrypoint syncs extensions before herdr listens,
    # and a switch must observe the NEW container (old id still answers
    # while compose is replacing it — returning then caused
    # server_not_running on the very next workspace/pane call).
    for i in $(seq 1 120); do
      CTR="" # force re-query: find_ctr caches
      if find_ctr; then
        if [[ $switching -eq 1 && -n "$old_ctr" && "$CTR" == "$old_ctr" ]]; then
          sleep 0.5
          continue # still the old container, recreate in flight
        fi
        if docker exec "$CTR" herdr status server >/dev/null 2>&1; then
          # API fully ready (status can succeed before workspace/pane
          # calls are served — probe once to avoid the race).
          if docker exec "$CTR" herdr workspace list >/dev/null 2>&1; then
            return 0
          fi
        fi
      fi
      sleep 0.5
    done
    die "the herdr server did not come up -- see: docker compose logs"
  fi
}

# run the herdr CLI inside the container
hcli() { docker exec "$CTR" herdr "$@"; }

# jq inside the container (the host needs no jq):  hcli ... | hjq -r '...'
hjq() { docker exec -i "$CTR" jq "$@"; }

# --- workspaces ----------------------------------------------------------
# Workspaces are found by id (w1...), by label (the folder's short path,
# e.g. "stack/services/pi-sandbox", unless renamed in the TUI), or by the folder
# itself (label match, then root-pane cwd match).

ws_find_by_label() {
  hcli workspace list \
    | hjq -r --arg lbl "$1" \
      '[.result.workspaces[] | select(.label == $lbl)][0].workspace_id // empty'
}

ws_find_by_folder() {
  local lbl="$1" cpath="$2" id
  id="$(ws_find_by_label "$lbl")"
  [[ -n "$id" ]] && { printf '%s' "$id"; return 0; }
  # fall back to the workspace whose root pane lives in that folder
  hcli pane list \
    | hjq -r --arg cwd "$cpath" \
      '[.result.panes[] | select(.cwd == $cwd
          and .pane_id == (.workspace_id + ":p1"))][0].workspace_id // empty'
}

# resolve "<path|name|id>" to an existing workspace: prints "wid<tab>label"
ws_resolve() {
  local arg="${1:-}" id label
  if [[ "$arg" =~ ^w[0-9]+$ ]]; then
    label="$(hcli workspace list \
      | hjq -r --arg id "$arg" \
        '[.result.workspaces[] | select(.workspace_id == $id)][0].label // empty')"
    [[ -n "$label" ]] || { err "no workspace $arg"; return 1; }
    printf '%s\t%s\n' "$arg" "$label"
    return 0
  fi
  id="$(ws_find_by_label "$arg")"
  if [[ -n "$id" ]]; then
    printf '%s\t%s\n' "$id" "$arg"
    return 0
  fi
  local abs cpath lbl
  abs="$(host_path "$arg")" || return 1
  cpath="$(container_path "$abs")"
  lbl="$(short_path "$abs")"
  id="$(ws_find_by_folder "$lbl" "$cpath")"
  [[ -n "$id" ]] || { err "no workspace for $abs — open it first: pi-run $abs"; return 1; }
  printf '%s\t%s\n' "$id" "$lbl"
}

# the folder a workspace label belongs to (empty when unknown, e.g. after
# a rename in the TUI)
ws_host_path() {
  host_path_from_ctr "/workspace/$1"
}

# --- pi defaults ---------------------------------------------------------
# Same rule as container/pi-entrypoint.sh: apply PI_DEFAULT_PROVIDER/
# MODEL/THINKING (see docker-compose.yml) unless the caller picked a model
# or thinking level themselves. Read from the container env, so the
# compose files stay the single source of truth.
pi_default_flags() {
  local user_model=0 user_thinking=0 a
  for a in "$@"; do
    case "$a" in
      --model|--model=*|-m|--models|--models=*) user_model=1 ;;
      --thinking|--thinking=*) user_thinking=1 ;;
    esac
  done
  PI_FLAGS=()
  local prov model think
  prov="$(docker exec "$CTR" printenv PI_DEFAULT_PROVIDER 2>/dev/null || true)"
  model="$(docker exec "$CTR" printenv PI_DEFAULT_MODEL 2>/dev/null || true)"
  think="$(docker exec "$CTR" printenv PI_DEFAULT_THINKING 2>/dev/null || true)"
  if [[ $user_model -eq 0 ]]; then
    # a caller-provided model may belong to another provider, so the
    # default provider is only paired with the default model
    [[ -n "$prov" ]] && PI_FLAGS+=(--provider "$prov")
    [[ -n "$model" ]] && PI_FLAGS+=(--model "$model")
  fi
  if [[ $user_thinking -eq 0 && -n "$think" ]]; then
    PI_FLAGS+=(--thinking "$think")
  fi
}

# fresh pi agent name for a folder: pi-<slug>-<hash>[-N], unique among
# live agents and within herdr's 32-char name limit
pick_agent_name() {
  local base="pi-$(slugify "$(basename "$1")")"
  base="${base:0:18}"
  local h cand existing i
  h="$(hash4 "$1")"
  existing="$(hcli agent list | hjq -r '.result.agents[].name' 2>/dev/null)"
  cand="${base}-${h}"
  if ! grep -qx -- "$cand" <<<"$existing"; then printf '%s' "$cand"; return 0; fi
  for ((i = 2; i < 100; i++)); do
    cand="${base}-${h}-$i"
    cand="${cand:0:32}"
    if ! grep -qx -- "$cand" <<<"$existing"; then printf '%s' "$cand"; return 0; fi
  done
  cand="${base}-${h}-$RANDOM"
  printf '%s' "${cand:0:32}"
}

# start a fresh pi in an existing shell pane: prints the agent name
# CLI flags (pi options) go to `agent start`; free prompt text goes via
# `agent prompt` — herdr rejects multiline prompt text as start args
# (invalid_agent_argument), but accepts it via prompt.
start_pi_in_pane() {
  local pane="$1" abs="$2"; shift 2
  pi_default_flags "$@"
  local name
  name="$(pick_agent_name "$abs")"
  # split leading pi flags (and their values) from the prompt text
  local start_args=() prompt_parts=() a needs_val=0
  for a in "$@"; do
    if [[ $needs_val -eq 1 ]]; then
      start_args+=("$a")
      needs_val=0
      continue
    fi
    case "$a" in
      --provider|--model|-m|--thinking|--timeout)
        start_args+=("$a"); needs_val=1 ;;
      --provider=*|--model=*|--thinking=*|-m*)
        start_args+=("$a") ;;
      -?*)
        start_args+=("$a") ;;
      *)
        prompt_parts+=("$a") ;;
    esac
  done
  if ! hcli agent start "$name" --kind pi --pane "$pane" \
      --timeout 60000 -- ${PI_FLAGS[@]+"${PI_FLAGS[@]}"} ${start_args[@]+"${start_args[@]}"} >/dev/null; then
    err "note: pi did not start as a recognized agent — the workspace is open, run pi in it yourself"
    return 1
  fi
  if [[ ${#prompt_parts[@]} -gt 0 ]]; then
    local prompt_text
    printf -v prompt_text '%s ' "${prompt_parts[@]}"
    prompt_text="${prompt_text% }"
    if ! hcli agent prompt "$name" "$prompt_text" >/dev/null; then
      err "note: pi started as $name but the prompt was rejected — type it in the pane yourself"
    fi
  fi
  printf '%s\n' "$name"
}

# start a fresh pi session in a new tab of an existing workspace and start
# pi there with the caller's args. Prints the agent name.
#
# --- parallel-session git isolation ----------------------------------------
# `pi-run <folder> "<prompt>"` on an existing workspace starts a FRESH pi
# session while the old one keeps running. That fresh session used to start
# in the SAME checkout: two agents then share one working tree and one
# branch — they overwrite each other's files, and whoever commits second
# forks history (parallel lanes that never merge; fixes land on a lane
# nobody tests). maybe_isolate_worktree prevents that: when the target
# folder is inside a git repo, the fresh session gets its own worktree on
# its own branch (agent/<slug>[-N], nested at <repo>/.worktrees/ so it
# stays inside the /workspace mounts — a sibling directory could fall
# outside a mount and never reach the host), mirroring
# container/pi-worktree.sh `create`. Prints
# "<worktree-host-path>\t<branch>\t<context-note>" for the caller to
# chdir into and prepend to the prompt; prints nothing and returns 1 when
# the folder is not a git repo, is already inside a worktree, or anything
# fails (the caller then falls back to the shared checkout).
maybe_isolate_worktree() {
  local abs="$1"; shift
  command -v git >/dev/null 2>&1 || return 1
  local root base slug branch path suffix n note ahead behind exclude
  root="$(git -C "$abs" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$root" ]] || return 1
  # already isolated (inside a linked worktree, whose .git is a file):
  # nothing to do
  [[ ! -f "$root/.git" ]] || return 1
  case "$abs" in
    "$root/.worktrees/"*) return 1 ;;
  esac
  base="$(git -C "$root" branch --show-current 2>/dev/null || true)"
  [[ -n "$base" ]] || base="HEAD"
  git -C "$root" rev-parse --verify --quiet "$base^{commit}" >/dev/null 2>&1 || return 1
  # best-effort fetch: never mutates the checkout, just freshens the
  # divergence check below (offline hosts skip it silently)
  git -C "$root" fetch origin --quiet 2>/dev/null || true
  # slug from the prompt words (pi flags and their values skipped),
  # short + filesystem-safe
  local w skip_next=0 words=()
  for w in "$@"; do
    if [[ $skip_next -eq 1 ]]; then skip_next=0; continue; fi
    case "$w" in
      --provider|--model|-m|--thinking|--timeout|-s|--sandbox) skip_next=1 ;;
      -*=*) ;;   # --flag=value form: drop
      -?*) ;;    # bare flag: drop (its value may leak into the slug — harmless)
      *) words+=("$w") ;;
    esac
  done
  if [[ ${#words[@]} -eq 0 ]]; then
    slug=""
  else
    slug="$(printf '%s ' "${words[@]}" | tr '[:upper:]' '[:lower:]' \
      | sed 's/[^a-z0-9-]/-/g; s/--*/-/g; s/^-//; s/-$//' \
      | cut -c1-32 | sed 's/-$//')"
  fi
  [[ -n "$slug" ]] || slug="task"
  n=1
  while :; do
    suffix=""; [[ $n -gt 1 ]] && suffix="-$n"
    branch="agent/${slug}${suffix}"
    path="$root/.worktrees/${slug}${suffix}"
    if git -C "$root" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null \
       || [[ -e "$path" ]]; then
      n=$((n + 1))
    else
      break
    fi
  done
  # keep nested worktrees out of `git status` in the main checkout
  exclude="$(git -C "$root" rev-parse --git-common-dir)/info/exclude"
  if ! grep -qxF '.worktrees/' "$exclude" 2>/dev/null; then
    mkdir -p "$(dirname "$exclude")" 2>/dev/null || true
    printf '.worktrees/\n' >> "$exclude" 2>/dev/null || true
  fi
  git -C "$root" worktree add -b "$branch" "$path" "$base" >/dev/null 2>&1 || return 1
  # divergence early warning, so the agent knows when its base is stale
  note=""
  if [[ "$base" != "HEAD" ]] && git -C "$root" rev-parse --verify --quiet "refs/remotes/origin/$base" >/dev/null 2>&1; then
    ahead="$(git -C "$root" rev-list --count "origin/$base..$base" 2>/dev/null || echo 0)"
    behind="$(git -C "$root" rev-list --count "$base..origin/$base" 2>/dev/null || echo 0)"
    if [[ "$behind" != "0" ]]; then
      note=" Local $base is $behind behind origin/$base ($ahead ahead) - run git pull --rebase in the main checkout before merging."
    fi
  fi
  printf 'pi-run: isolated parallel session in worktree %s (branch %s, base %s)\n' "$path" "$branch" "$base" >&2
  printf '%s\t%s\t%s' "$path" "$branch" "[pi-run: you are in worktree $path on branch $branch (base $base). Stay in this directory for the whole task; set up deps as needed (node_modules/.env are not copied). Commit on this branch and open a PR with pi-worktree propose ${branch#agent/} (pushes, opens a PR with gh, removes the worktree; the branches and PR stay for a human to merge — if gh/origin is unavailable, use pi-worktree finish instead). Do not commit to $base from here, never merge into it yourself and never merge the PR.$note]"
}
new_pi_in_new_tab() {
  local wid="$1" cdir="$2" abs="$3"; shift 3
  local tab_out newpane
  tab_out="$(hcli tab create --workspace "$wid" --cwd "$cdir" --focus)" \
    || die "could not create a new tab in the workspace"
  newpane="$(printf '%s' "$tab_out" | hjq -r '.result.root_pane.pane_id // empty')"
  [[ -n "$newpane" ]] || die "could not read the new tab's pane id"
  echo "starting a fresh pi session in $newpane"
  start_pi_in_pane "$newpane" "$abs" "$@" || true
}
# start a fresh pi session in an existing workspace: split a new pane off a
# live one and start pi there with the caller's args. Prints the agent name.
new_pi_in_workspace() {
  local wid="$1" cdir="$2" abs="$3"; shift 3
  local base split_out newpane
  # focused pane of the workspace, else its first pane
  base="$(hcli pane list --workspace "$wid" 2>/dev/null \
    | hjq -r '([.result.panes[] | select(.focused)][0] // .result.panes[0]).pane_id // empty')"
  [[ -n "$base" ]] || die "no pane in workspace to split for a fresh pi session"
  split_out="$(hcli pane split "$base" --direction right --cwd "$cdir")" \
    || die "could not split a new pane in the workspace"
  newpane="$(printf '%s' "$split_out" | hjq -r '.result.pane.pane_id // empty')"
  [[ -n "$newpane" ]] || die "could not read the new pane id"
  echo "starting a fresh pi session in $newpane"
  start_pi_in_pane "$newpane" "$abs" "$@" || true
}
# The image is self-extending: pi-install records newly needed packages in
# the Dockerfile. A stamp label in the image lets us detect that the image
# no longer matches its sources and rebuild before starting anything.
image_stamp() {
  {
    sha256sum "$SERVICE_DIR/container/Dockerfile" "$SERVICE_DIR/container/pi-install.sh" \
      "$SERVICE_DIR/container/pi-entrypoint.sh" "$SERVICE_DIR/container/install-herdr.sh" \
      "$SERVICE_DIR/container/pi-extensions.txt" "$SERVICE_DIR/container/pi-extensions-sync.sh" \
      "$SERVICE_DIR/container/pi-wrapper.sh" "$SERVICE_DIR/container/pi-worktree.sh" \
    "$SERVICE_DIR/container/pi-hostpath.sh" \
      2>/dev/null
    # the host's docker GID is part of the stamp: the pi user is joined
    # to that group at build time, so a GID change must trigger a rebuild
    # or `docker ps` stays permission-denied
    getent group docker 2>/dev/null || echo "no-host-docker-group"
  } | sha256sum | cut -c1-16
}

ensure_image() {
  local want have gid
  want="$(image_stamp)"
  have="$(docker image inspect "$IMAGE" -f '{{ index .Config.Labels "pi.service.stamp" }}' 2>/dev/null || true)"
  if [[ "$want" != "$have" ]]; then
    echo "$IMAGE image out of date (Dockerfile/scripts changed) — rebuilding..."
    # host's docker GID, so the pi user may use the mounted socket (see
    # README "Docker for e2e tests"); empty when the host has no docker
    gid="$(getent group docker 2>/dev/null | cut -d: -f3 || true)"
    # shellcheck disable=SC2086
    (cd "$SERVICE_DIR" && docker compose build --build-arg PI_STAMP="$want" ${gid:+--build-arg DOCKER_GID="$gid"})
  fi
}

# --- commands ------------------------------------------------------------

attach() {
  [[ -t 0 && -t 1 ]] || die "not a terminal — use -b to open a workspace without attaching"
  echo "herdr TUI — detach with ctrl+b q (panes and agents keep running)"
  exec docker exec -it \
    -e TERM="${TERM:-xterm-256color}" -e COLORTERM="${COLORTERM:-}" \
    "$CTR" herdr
}

# focus an existing workspace and (optionally) attach the TUI to it
jump_to() {
  local wid="$1" label="$2" bg="$3"
  hcli workspace focus "$wid" >/dev/null || true
  if [[ $bg -eq 1 ]]; then
    echo "opened $label — attach with: pi-run $label"
  else
    attach
  fi
}

cmd_sandboxes() {
  local set_val="" unset_cfg=0 arg="" cur s img mark present desc
  while :; do
    case "${1:-}" in
      --set) [[ $# -ge 2 ]] || die "missing value for --set (want default|android)"; set_val="$2"; shift 2 ;;
      --set=*) set_val="${1#--set=}"; shift ;;
      -s|--sandbox) [[ $# -ge 2 ]] || die "missing value for $1 (want default|android)"; SANDBOX="$2"; SANDBOX_FROM_CLI=1; shift 2 ;;
      --sandbox=*) SANDBOX="${1#--sandbox=}"; SANDBOX_FROM_CLI=1; shift ;;
      --unset) unset_cfg=1; shift ;;
      --) shift; break ;;
      -*) die "unknown flag for sandboxes: $1 (want --set <name> | --unset | [path])" ;;
      *) break ;;
    esac
  done
  if [[ $# -gt 0 ]]; then arg="$1"; shift; fi
  [[ $# -eq 0 ]] || die "too many arguments for sandboxes (want [path])"
  if [[ -n "$set_val" && $unset_cfg -eq 1 ]]; then
    die "cannot combine --set and --unset"
  fi
  case "$set_val" in
    ""|default|android) ;;
    *) die "unknown sandbox: $set_val (want default|android)" ;;
  esac
  select_sandbox
  cur="$SANDBOX"
  if [[ -n "$set_val" || $unset_cfg -eq 1 ]]; then
    # write or remove the per-workspace default: <workspace>/.pi-sandbox
    local target="${arg:-.}" abs cfg
    abs="$(host_path "$target")" || exit 1
    cfg="$abs/$WORKSPACE_CONFIG_NAME"
    if [[ -n "$set_val" ]]; then
      printf '# pi sandbox default for this workspace (used by pi-run).\n# Precedence: -s/--sandbox flag, then PI_SANDBOX env, then this file.\nsandbox=%s\n' "$set_val" >"$cfg"         || die "cannot write $cfg"
      echo "workspace default sandbox for $abs: $set_val (wrote $cfg)"
      return 0
    else
      if [[ -f "$cfg" ]]; then
        rm -f "$cfg" || die "cannot remove $cfg"
        echo "removed workspace default sandbox ($cfg)"
      else
        echo "no workspace default sandbox set for $abs (no $cfg)"
      fi
      return 0
    fi
  fi
  printf '%-10s %-22s %-9s %s\n' SANDBOX IMAGE BUILT DESCRIPTION
  for s in default android; do
    img="pi-sandbox"
    desc="Ubuntu base + Node.js + Docker CLI + pi/vibeflow (everyday work)"
    if [[ "$s" == android ]]; then
      img="pi-sandbox-android"
      desc="default + JDK + Android SDK + Gradle + Kotlin (Kotlin/Android builds)"
    fi
    mark=""; [[ "$s" == "$cur" ]] && mark="*"
    present="missing"
    docker image inspect "$img" >/dev/null 2>&1 && present="yes"
    printf '%-10s %-22s %-9s %s %s\n' "$s" "$img" "$present" "$desc" "$mark"
  done
  echo
  echo "* selected (PI_SANDBOX=$cur). Use: pi-run -s android <path>  (or PI_SANDBOX=android pi-run <path>)"
  # per-workspace default for the given path (or cwd when resolvable)
  local wp="${arg:-.}" wabs wcfg wval
  if wabs="$(host_path "$wp" 2>/dev/null)"; then
    wcfg="$(workspace_config_file "$wabs")"
    if [[ -n "$wcfg" ]]; then
      wval="$(read_workspace_sandbox "$wabs")"
      echo "workspace default for $wabs: ${wval:-<invalid, see warning>} (from $wcfg)"
    else
      echo "workspace default for $wabs: none (no $WORKSPACE_CONFIG_NAME file)"
    fi
    echo "set it with: pi-run sandboxes --set <default|android> [$wp]"
  elif [[ -n "$arg" ]]; then
    echo "workspace default: (could not resolve '$arg' to a mounted folder)"
  fi
}

cmd_open() {
  local bg=0 newtab=0 path fresh=new_pi_in_workspace
  while :; do
    case "${1:-}" in
      -b|--background) bg=1 ;;
      --tab|--new-window) newtab=1 ;;
      -s|--sandbox) [[ $# -ge 2 ]] || die "missing value for $1 (want default|android)"; SANDBOX="$2"; SANDBOX_FROM_CLI=1; shift ;;
      --sandbox=*) SANDBOX="${1#--sandbox=}"; SANDBOX_FROM_CLI=1 ;;
      *) break ;;
    esac
    shift
  done
  select_sandbox
  if [[ $newtab -eq 1 ]]; then fresh=new_pi_in_new_tab; else fresh=new_pi_in_workspace; fi
  if [[ $# -gt 0 && "$1" != -* ]]; then
    path="$1"
    shift
  else
    # no folder given: the current one ("." is accepted explicitly)
    path="."
  fi

  # per-workspace default (when the path resolves to a folder without
  # needing the container); workspace ids/names are re-checked below
  # after ws_resolve, once their folder is known
  if [[ "$path" == /* || "$path" == .* || "$path" == "~"* || "$path" != -* ]]; then
    tentative="$(host_path "$path" 2>/dev/null || true)"
    if [[ -n "${tentative:-}" ]]; then
      maybe_apply_workspace_sandbox "$tentative" || true
    fi
  fi

  ensure_stack

  local abs="" out wid label tentative wabs wt _wt_branch _wt_note
  if [[ "$path" == "." ]] && ! abs="$(host_path . 2>/dev/null)"; then
    # from outside the mounted folders with no path given: just attach
    # wherever the TUI was left (its focused workspace)
    if [[ $# -gt 0 ]]; then
      die "the current folder is not mounted (mounted: $(joined_hosts))"
    fi
    if [[ $bg -eq 1 ]]; then
      echo "the current folder is not mounted — attaching is the only option (drop -b)"
      exit 1
    fi
    attach
  fi
  if [[ -z "$abs" ]]; then
    if ! abs="$(host_path "$path" 2>/dev/null)"; then
      # not a folder — a workspace id (w3) or name, then
      out="$(ws_resolve "$path")" || exit 1
      IFS=$'\t' read -r wid label <<<"$out"
      wabs="$(ws_host_path "$label" 2>/dev/null || true)"
      if [[ -n "${wabs:-}" ]]; then
        if maybe_apply_workspace_sandbox "$wabs" || true; then
          : # maybe_apply already re-ran select_sandbox on change
        fi
        # recreate when the workspace file points at another variant
        ensure_stack
      fi
      if [[ $# -gt 0 ]]; then
        abs="$(ws_host_path "$label")"
        if [[ -n "$abs" ]]; then
          # parallel prompt session: isolate it in its own worktree when
          # the folder is a git repo (two agents sharing one checkout
          # clobber files and fork history — see maybe_isolate_worktree)
          if wt="$(maybe_isolate_worktree "$abs" "$@")"; then
            IFS=$'\t' read -r abs _wt_branch _wt_note <<<"$wt"
            set -- "$_wt_note" "$@"
          fi
          "$fresh" "$wid" "$(container_path "$abs")" "$abs" "$@"
        else
          err "note: renamed workspace has no folder mapping, reusing live session"
        fi
      fi
      jump_to "$wid" "$label" "$bg"
      return
    fi
  fi

  local cdir lbl pid
  cdir="$(container_path "$abs")"
  lbl="$(short_path "$abs")"
  wid="$(ws_find_by_folder "$lbl" "$cdir")"

  if [[ -n "$wid" ]]; then
    if [[ $# -gt 0 ]]; then
      # prompt passed but workspace exists: fresh pi session in a new pane
      # (or a new tab with --tab), the running session keeps running untouched.
      # A parallel session in the SAME checkout would share files/branch
      # with the running one and fork history — isolate it in its own
      # worktree when the folder is a git repo (see maybe_isolate_worktree).
      if wt="$(maybe_isolate_worktree "$abs" "$@")"; then
        IFS=$'\t' read -r abs _wt_branch _wt_note <<<"$wt"
        cdir="$(container_path "$abs")"
        set -- "$_wt_note" "$@"
      fi
      "$fresh" "$wid" "$cdir" "$abs" "$@"
    fi
  else
    echo "opening workspace $lbl"
    out="$(hcli workspace create --cwd "$cdir" --label "$lbl" --focus)" \
      || die "could not create a herdr workspace for $abs"
    wid="$(printf '%s' "$out" | hjq -r '.result.workspace.workspace_id')"
    pid="$(printf '%s' "$out" | hjq -r '.result.root_pane.pane_id')"
    # first open of the folder starts pi in its workspace, with
    # the PI_DEFAULT_* defaults unless the caller chose a model
    start_pi_in_pane "$pid" "$abs" "$@" || true
  fi

  jump_to "$wid" "$lbl" "$bg"
}

cmd_ls() {
  require_stack
  local watch=0
  if [[ "${1:-}" == "-w" || "${1:-}" == "--watch" ]]; then watch=1; fi
  while true; do
    if [[ $watch -eq 1 ]]; then
      clear
      echo "pi sandbox — $(date '+%Y-%m-%d %H:%M:%S') — ctrl+c to stop watching"
      echo
    fi
    printf '%-8s %-28s %-9s %-9s %s\n' WORKSPACE FOLDER STATE AGENT LAST
    hcli workspace list | hjq -r \
      '.result.workspaces[] | [.workspace_id, .label,
        (if .focused then "focused" else "-" end),
        (.agent_status // "-")] | @tsv' \
    | while IFS=$'\t' read -r wid lbl state st; do
        local last
        last="$(hcli pane read "$wid:p1" --source recent-unwrapped --lines 40 2>/dev/null \
          | sed 's/[[:space:]]*$//' | awk 'NF { l = $0 } END { print l }' | cut -c1-44)"
        printf '%-8s %-28s %-9s %-9s %s\n' "$wid" "$lbl" "$state" "$st" "${last:-}"
      done
    echo
    printf '%-8s %-12s %-9s %-8s %s\n' AGENT KIND STATE WORKSPACE PANE
    hcli agent list | hjq -r \
      '.result.agents[] | [.name, .agent, .agent_status, .workspace_id, .pane_id] | @tsv' \
    | while IFS=$'\t' read -r name kind st wid pane; do
        printf '%-8s %-12s %-9s %-8s %s\n' "$name" "$kind" "$st" "$wid" "$pane"
      done
    if [[ $watch -eq 0 ]]; then break; fi
    sleep 2
  done
}

cmd_log() {
  require_stack
  local out wid label pid
  out="$(ws_resolve "${1:-.}")" || exit 1
  IFS=$'\t' read -r wid label <<<"$out"
  # the workspace's focused pane, else its first one
  pid="$(hcli pane list --workspace "$wid" | hjq -r \
    '([.result.panes[] | select(.focused)][0] // .result.panes[0]).pane_id // empty')"
  [[ -n "$pid" ]] || die "no pane in workspace $label"
  hcli pane read "$pid" --source recent-unwrapped --lines 300
}

cmd_shell() {
  while :; do
    case "${1:-}" in
      -s|--sandbox) [[ $# -ge 2 ]] || die "missing value for $1 (want default|android)"; SANDBOX="$2"; SANDBOX_FROM_CLI=1; shift 2 ;;
      --sandbox=*) SANDBOX="${1#--sandbox=}"; SANDBOX_FROM_CLI=1; shift ;;
      *) break ;;
    esac
  done
  select_sandbox
  local arg="${1:-}" out wid label abs cdir tentative
  if [[ $# -gt 0 && "$1" != -* ]]; then
    # tentative target (may be a folder, name or id)
    if tentative="$(host_path "$1" 2>/dev/null || true)"; then
      if [[ -n "${tentative:-}" ]]; then
        maybe_apply_workspace_sandbox "$tentative" || true
      fi
    fi
  else
    arg="."
    if tentative="$(host_path . 2>/dev/null || true)"; then
      if [[ -n "${tentative:-}" ]]; then
        maybe_apply_workspace_sandbox "$tentative" || true
      fi
    fi
  fi
  ensure_stack
  if [[ $# -gt 0 && "$1" != -* ]]; then
    shift
  else
    arg="."
  fi
  if out="$(ws_resolve "$arg" 2>/dev/null)"; then
    IFS=$'\t' read -r wid label <<<"$out"
    abs="$(ws_host_path "$label")"
    [[ -n "$abs" ]] || die "no folder recorded for workspace $label"
    if maybe_apply_workspace_sandbox "$abs" || true; then
      : # maybe_apply already re-ran select_sandbox on change
    fi
    ensure_stack
  else
    abs="$(host_path "$arg")" || exit 1
  fi
  cdir="$(container_path "$abs")"
  local tflags="-i"
  [[ -t 0 && -t 1 ]] && tflags="-it"
  # shellcheck disable=SC2086
  if [[ $# -gt 0 ]]; then
    local cmd
    printf -v cmd '%q ' "$@"
    exec docker exec $tflags -w "$cdir" "$CTR" bash -c "$cmd"
  fi
  exec docker exec $tflags -w "$cdir" "$CTR" bash
}

kill_ws() {
  local out wid label
  out="$(ws_resolve "$1")" || return 1
  IFS=$'\t' read -r wid label <<<"$out"
  hcli workspace close "$wid" >/dev/null || die "could not close $label"
  echo "closed $label"
}

cmd_kill() {
  require_stack
  if [[ "${1:-}" == "--all" ]]; then
    local ids id
    ids="$(hcli workspace list | hjq -r '.result.workspaces[].workspace_id')"
    for id in $ids; do
      hcli workspace close "$id" >/dev/null 2>&1 || true
    done
    echo "closed all workspaces (the sandbox keeps running)"
  else
    kill_ws "${1:-.}" || exit 1
  fi
}

cmd_down() {
  echo "stopping the sandbox — herdr restores the layout and pi sessions on the next start"
  compose down
}

# Pin a pi version in the Dockerfile and rebuild. Without a version it
# pins the latest release from the npm registry. This is persistent: the
# version lives in the Dockerfile like every other image property, so all
# future builds keep it. (`pi update` inside a session is NOT — it only
# changes the throwaway container.)
cmd_upgrade() {
  local ver="${1:-}" old
  if [[ -z "$ver" ]]; then
    command -v npm >/dev/null 2>&1 \
      || die "npm not found on the host — pass a version: pi-run upgrade <version>"
    if ! ver="$(npm view @earendil-works/pi-coding-agent version 2>/dev/null)"; then
      die "could not query npm for the latest version"
    fi
  fi
  [[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.+-][A-Za-z0-9.+-]*)?$ ]] \
    || die "invalid version: $ver"
  old="$(sed -n 's/^ARG PI_VERSION=//p' "$SERVICE_DIR/container/Dockerfile")"
  if [[ "$old" == "$ver" ]]; then
    echo "pi already pinned to $ver in Dockerfile"
  else
    sed -i "s/^ARG PI_VERSION=.*/ARG PI_VERSION=${ver}/" "$SERVICE_DIR/container/Dockerfile"
    echo "pi pinned to $ver in Dockerfile (was ${old:-unset})"
  fi
  ensure_image
  echo "done — new sessions run pi $ver"
}

# Same for herdr: pinned via ARG HERDR_VERSION, baked into the next build.
# (`herdr update` inside the container only changes the running container.)
cmd_upgrade_herdr() {
  local ver="${1:-}" old
  if [[ -z "$ver" ]]; then
    if ! ver="$(curl -fsSL --max-time 20 https://herdr.dev/latest.json \
        | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"; then
      die "could not query herdr.dev for the latest version"
    fi
  fi
  [[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.+-][A-Za-z0-9.+-]*)?$ ]] \
    || die "invalid version: $ver"
  old="$(sed -n 's/^ARG HERDR_VERSION=//p' "$SERVICE_DIR/container/Dockerfile")"
  if [[ "$old" == "$ver" ]]; then
    echo "herdr already pinned to $ver in Dockerfile"
  else
    sed -i "s/^ARG HERDR_VERSION=.*/ARG HERDR_VERSION=${ver}/" "$SERVICE_DIR/container/Dockerfile"
    echo "herdr pinned to $ver in Dockerfile (was ${old:-unset})"
  fi
  ensure_image
  echo "done — new sessions run herdr $ver"
}

# Same for the compose plugin: pinned via ARG COMPOSE_VERSION. Without a
