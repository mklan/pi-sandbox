# leading sandbox selection (before the subcommand): pi-run -s android ...
# (only leading flags are consumed here, so prompt text passed to pi can
# never be mistaken for this flag; `open`/`shell` also accept it later)
while :; do
  case "${1:-}" in
    -s|--sandbox) [[ $# -ge 2 ]] || die "missing value for $1 (want default|android)"; SANDBOX="$2"; SANDBOX_FROM_CLI=1; shift 2 ;;
    --sandbox=*) SANDBOX="${1#--sandbox=}"; SANDBOX_FROM_CLI=1; shift ;;
    *) break ;;
  esac
done
select_sandbox

case "${1:-}" in
  ""|open) shift 2>/dev/null || true; cmd_open "$@" ;;
  sandboxes|sandbox|variants) shift 2>/dev/null || true; cmd_sandboxes "$@" ;;
  ls|list|ps) shift; cmd_ls "$@" ;;
  log|peek) shift; cmd_log "$@" ;;
  shell|sh|bash) shift; cmd_shell "$@" ;;
  kill|stop|rm) shift; cmd_kill "$@" ;;
  down) shift; cmd_down "$@" ;;
  upgrade|up|update) shift; cmd_upgrade "$@" ;;
  upgrade-herdr) shift; cmd_upgrade_herdr "$@" ;;
  upgrade-node) shift; cmd_upgrade_node "$@" ;;
  upgrade-docker) shift; cmd_upgrade_docker "$@" ;;
  upgrade-compose) shift; cmd_upgrade_compose "$@" ;;
  upgrade-kotlin) shift; cmd_upgrade_kotlin "$@" ;;
  upgrade-gradle) shift; cmd_upgrade_gradle "$@" ;;
  help|-h|--help) usage ;;
  *) cmd_open "$@" ;;
esac
